# === Telegram Bot ===
# @BotFather에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 허용할 텔레그램 유저 ID (쉼표 구분)
# 비워두면 모든 사용자 허용 (권장하지 않음)
# 본인 유저 ID는 @userinfobot 에게 메시지를 보내면 확인 가능
TELEGRAM_USER_IDS=123456789

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8080

# === Agent Config ===
AGENTS_CONFIG=config/agents.yaml
